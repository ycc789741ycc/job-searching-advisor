# Rule 2: the domain model inside each component is pure: no application
# code, no kernel, no framework, no I/O. It is the bottom layer of its
# component and imports nothing else from it.
[importlinter:contract:pure-domain]
name = A component's domain imports no kernel, delivery code or framework
type = forbidden
source_modules =
    advisor.identity.domain
    advisor.profile.domain
    advisor.market.domain
    advisor.rolemap.domain
    advisor.assessment.domain
    advisor.target.domain
    advisor.gapplan.domain
    advisor.resume.domain
forbidden_modules =
    api
    worker
    crawler
    cli
    wiring
    kernel
    advisor.*.service
    advisor.*.infra
    advisor.*.jobs
    fastapi
    sqlalchemy
    httpx
    boto3
    procrastinate
    alembic

# Rule 3: domain models stay independent of one another. A concept two
# components need gets its own component rather than a link between models.
[importlinter:contract:domains-independent]
name = Component domain models do not import each other
type = independence
modules =
    advisor.identity.domain
    advisor.profile.domain
    advisor.market.domain
    advisor.rolemap.domain
    advisor.assessment.domain
    advisor.target.domain
    advisor.gapplan.domain
    advisor.resume.domain

# Rule 4: the application holds no framework or delivery code (design
# guideline, package by component). Routes live in api/, task registration in
# wiring/, entrypoints in worker/, crawler/ and cli/.
[importlinter:contract:application-has-no-delivery-code]
name = advisor imports no deployable, no composition root and no web or queue framework
type = forbidden
source_modules =
    advisor
forbidden_modules =
    api
    worker
    crawler
    cli
    wiring
    fastapi
    starlette
    uvicorn
    procrastinate

# Rule 5: components form no cycles. Each layer may use the ones below it;
# `|` marks siblings that must not use each other.
[importlinter:contract:components-acyclic]
name = Components depend on each other in one direction only
type = layers
containers =
    advisor
layers =
    gapplan | resume
    target
    assessment
    rolemap
    identity | profile | market

# Rule 6: the crawler is a separate deployable with a narrow surface: the market
# component's public API and the kernel pieces it needs, nothing else.
[importlinter:contract:crawler-surface]
name = crawler imports only advisor.market, its own wiring and allowed kernel pieces
type = forbidden
source_modules =
    crawler
forbidden_modules =
    kernel.crypto
    kernel.ai_gateway
    kernel.auth
    kernel.storage
    kernel.jobs
    api
    worker
    cli
    wiring.container
    wiring.queue
    wiring.models
    advisor.identity
    advisor.profile
    advisor.rolemap
    advisor.assessment
    advisor.target
    advisor.gapplan
    advisor.resume
    advisor.market.service
    advisor.market.domain
    advisor.market.infra
    advisor.market.jobs
    advisor.market.baseline
    advisor.market.crawling
# Direct imports only: the crawler goes through advisor.market, which
# necessarily sits on top of that component's own domain and infra.
allow_indirect_imports = True

# Rule 7: the crawler process never loads a secret-holding piece, not even
# indirectly. It holds no secrets by design (technical_boundaries section 4),
# which is why its wiring lives apart from wiring.container.
[importlinter:contract:crawler-holds-no-secrets]
name = crawler never reaches crypto, the AI gateway, auth or object storage
type = forbidden
source_modules =
    crawler
forbidden_modules =
    kernel.crypto
    kernel.ai_gateway
    kernel.auth
    kernel.storage

# Rule 8: only the AI gateway and the profile connectors may decrypt, and
# identity may encrypt the credential it stores.
[importlinter:contract:decrypt-callers]
name = Only kernel.ai_gateway, advisor.identity and advisor.profile may import kernel.crypto
type = forbidden
source_modules =
    api
    worker
    crawler
    cli
    wiring
    advisor.market
    advisor.rolemap
    advisor.assessment
    advisor.target
    advisor.gapplan
    advisor.resume
forbidden_modules =
    kernel.crypto
# Direct imports only: reaching kernel.crypto *through* the gateway is the
# supported path, and is what the gateway exists for.
allow_indirect_imports = True

# Rule 9: components never touch an LLM SDK directly.
[importlinter:contract:no-direct-llm]
name = Components reach an LLM only through kernel.ai_gateway
type = forbidden
source_modules =
    advisor
    crawler
forbidden_modules =
    kernel.ai_gateway.providers
# Direct imports only: the gateway itself necessarily imports its adapters, and
# every component reaches them through it.
allow_indirect_imports = True

# Rule 10: the kernel is a technical kernel. It knows no domain and no
# deployable (docs/decisions/0009 records why it sits outside advisor/).
[importlinter:contract:kernel-knows-no-domain]
name = kernel never imports a component, a deployable or the composition root
type = forbidden
source_modules =
    kernel
forbidden_modules =
    advisor
    api
    worker
    crawler
    cli
    wiring

# Rule 11: ingestion is deterministic (domain decision 18). A sync must never
# spend the user's key, and the most hostile input — repositories, tickets,
# uploaded files — never reaches a prompt from here. Indirect imports count.
[importlinter:contract:profile-no-ai]
name = advisor.profile never reaches the AI gateway
type = forbidden
source_modules =
    advisor.profile
forbidden_modules =
    kernel.ai_gateway

# Rule 12: only persistence code touches the ORM (ADR 0011). A component's
# domain, use cases and crawling reach stored data through the repository
# interfaces its domain defines; its infra/ implements them and is the only
# code that imports the ORM, the vector type or the driver. The factory that
# wires infra/ in is exempt, as the composition root is. Components join this
# list as they move over.
[importlinter:contract:orm-only-in-persistence]
name = Only a component's infra imports the ORM or the database package
type = forbidden
source_modules =
    advisor.market.domain
    advisor.market.service
    advisor.market.jobs
    advisor.market.crawling
    advisor.market.baseline
    advisor.profile.domain
    advisor.profile.service
    advisor.profile.jobs
    advisor.identity.domain
    advisor.identity.service
    advisor.identity.auth
    advisor.identity.google
forbidden_modules =
    sqlalchemy
    pgvector
    asyncpg
    kernel.db
    kernel.outbox.models
    kernel.outbox.writer
    advisor.market.infra
    advisor.profile.infra.models
    advisor.profile.infra.mappers
    advisor.profile.infra.repositories
    advisor.profile.infra.unit_of_work
    advisor.identity.infra.models
    advisor.identity.infra.mappers
    advisor.identity.infra.repositories
    advisor.identity.infra.unit_of_work
