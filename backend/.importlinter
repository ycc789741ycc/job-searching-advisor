# Module boundaries from docs/technical_boundaries.md section 2, enforced in CI
# by `make lint`. It lives here so it ships inside the tools image and the gate
# mounts nothing from the host.
# A violation here is a design defect, not a style nit.

[importlinter]
root_packages =
    app
    kernel
    domain
    modules
    crawler
include_external_packages = True

# Rule 1: a module imports another module ONLY through its public.py.
[importlinter:contract:module-public-surface]
name = Modules talk to each other only through public.py
type = forbidden
source_modules =
    modules.identity
    modules.profile
    modules.market
    modules.rolemap
    modules.assessment
forbidden_modules =
    modules.identity.infra
    modules.identity.api
    modules.profile.infra
    modules.profile.api
    modules.profile.jobs
    modules.market.infra
    modules.market.api
    modules.market.jobs
    modules.rolemap.infra
    modules.rolemap.api
    modules.rolemap.jobs
    modules.assessment.infra
    modules.assessment.api
    modules.assessment.jobs
# Direct imports only. Reaching another module's internals *through* its
# public.py is the design; typing `modules.rolemap.infra.models` is not.
allow_indirect_imports = True

# Rule 2: the domain model lives in one top-level domain/ folder, one package
# per feature (design guideline, backend architecture: domain folder layout).
# It is pure: no application code, no kernel, no framework.
[importlinter:contract:pure-domain]
name = domain/ imports no application code, kernel or framework
type = forbidden
source_modules =
    domain
forbidden_modules =
    app
    kernel
    modules
    crawler
    fastapi
    sqlalchemy
    httpx
    boto3
    procrastinate
    alembic

# Rule 3: the crawler is a separate deployable with a narrow surface.
[importlinter:contract:crawler-surface]
name = crawler imports only its allowed kernel pieces and market.public
type = forbidden
source_modules =
    crawler
forbidden_modules =
    kernel.crypto
    kernel.ai_gateway
    kernel.auth
    kernel.storage
    kernel.jobs
    modules.identity
    modules.profile
    modules.rolemap
    modules.assessment
    domain
    modules.market.infra
    modules.market.api
    modules.market.jobs
# Direct imports only: the crawler goes through modules.market.public, which
# necessarily sits on top of that module's own domain and infra.
allow_indirect_imports = True

# Rule 4: only the AI gateway and the profile connectors may decrypt.
[importlinter:contract:decrypt-callers]
name = Only kernel.ai_gateway and profile connectors may import kernel.crypto
type = forbidden
source_modules =
    modules.identity.api
    modules.market
    modules.rolemap
    modules.assessment
    crawler
    app
forbidden_modules =
    kernel.crypto
# Direct imports only: reaching kernel.crypto *through* the gateway is the
# supported path, and is what the gateway exists for.
allow_indirect_imports = True

# Rule 5: modules never touch an LLM SDK directly.
[importlinter:contract:no-direct-llm]
name = Modules reach an LLM only through kernel.ai_gateway
type = forbidden
source_modules =
    modules.identity
    modules.profile
    modules.market
    modules.rolemap
    modules.assessment
    crawler
forbidden_modules =
    kernel.ai_gateway.providers
# Direct imports only: the gateway itself necessarily imports its adapters, and
# every module reaches them through it.
allow_indirect_imports = True

# Rule 6: the kernel is a technical kernel. It knows no domain.
[importlinter:contract:kernel-knows-no-domain]
name = kernel/ never imports a domain module
type = forbidden
source_modules =
    kernel
forbidden_modules =
    domain
    modules
    crawler
    app

# Rule 7: ingestion is deterministic (domain decision 18). A sync must never
# spend the user's key, and the most hostile input — repositories, tickets,
# uploaded files — never reaches a prompt from here.
[importlinter:contract:profile-no-ai]
name = profile never reaches the AI gateway
type = forbidden
source_modules =
    modules.profile
forbidden_modules =
    kernel.ai_gateway
# Indirect imports count, except the router's two edges into the composition
# root, which wires every module together; that is wiring, not ingestion.
ignore_imports =
    modules.profile.api -> app.dependencies
    modules.profile.api -> app.queue

# Rule 8: domain feature packages stay independent of one another. Nothing
# crosses between them today; a concept two features need gets its own feature
# package (the guideline's `domain/money/` case) rather than a link.
[importlinter:contract:domain-features-independent]
name = domain feature packages do not import each other
type = independence
modules =
    domain.identity
    domain.profile
    domain.market
    domain.rolemap
    domain.assessment

# Rule 9: a module uses only its own domain package. Another module's rules are
# reached through that module's public.py (rule 1), never by importing its
# domain package directly.
[importlinter:contract:identity-own-domain-only]
name = modules.identity imports only domain.identity
type = forbidden
source_modules =
    modules.identity
forbidden_modules =
    domain.profile
    domain.market
    domain.rolemap
    domain.assessment
allow_indirect_imports = True

[importlinter:contract:profile-own-domain-only]
name = modules.profile imports only domain.profile
type = forbidden
source_modules =
    modules.profile
forbidden_modules =
    domain.identity
    domain.market
    domain.rolemap
    domain.assessment
allow_indirect_imports = True

[importlinter:contract:market-own-domain-only]
name = modules.market imports only domain.market
type = forbidden
source_modules =
    modules.market
forbidden_modules =
    domain.identity
    domain.profile
    domain.rolemap
    domain.assessment
allow_indirect_imports = True

[importlinter:contract:rolemap-own-domain-only]
name = modules.rolemap imports only domain.rolemap
type = forbidden
source_modules =
    modules.rolemap
forbidden_modules =
    domain.identity
    domain.profile
    domain.market
    domain.assessment
allow_indirect_imports = True

[importlinter:contract:assessment-own-domain-only]
name = modules.assessment imports only domain.assessment
type = forbidden
source_modules =
    modules.assessment
forbidden_modules =
    domain.identity
    domain.profile
    domain.market
    domain.rolemap
allow_indirect_imports = True
