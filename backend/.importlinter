# Package boundaries from docs/technical_boundaries.md section 2 and
# docs/decisions/0009, enforced in CI by `make lint`. It lives here so it ships
# inside the tools image and the gate mounts nothing from the host.
# A violation here is a design defect, not a style nit.

[importlinter]
root_packages =
    api
    worker
    crawler
    cli
    wiring
    kernel
    advisor
include_external_packages = True

# Rule 1: a component's __init__ is its only public API. Nothing outside the
# component — another component, a deployable, the composition root or the
# kernel — imports any of its submodules. One contract per component,
# so each names exactly what is private to it.
#
# `jobs` is the one public submodule: the worker's task registration
# (wiring.queue) imports it to run those use cases.
#
# Direct imports only. Reaching a component's internals *through* its
# __init__ is the design; typing `advisor.rolemap.infra.models` is not.

[importlinter:contract:identity-public-surface]
name = Only advisor.identity itself is importable from outside the component
type = forbidden
source_modules =
    api
    worker
    crawler
    cli
    wiring
    kernel
    advisor.profile
    advisor.market
    advisor.rolemap
    advisor.assessment
    advisor.target
    advisor.gapplan
    advisor.resume
forbidden_modules =
    advisor.identity.service
    advisor.identity.domain
    advisor.identity.infra
    advisor.identity.auth
    advisor.identity.google
allow_indirect_imports = True

[importlinter:contract:profile-public-surface]
name = Only advisor.profile itself is importable from outside the component
type = forbidden
source_modules =
    api
    worker
    crawler
    cli
    wiring
    kernel
    advisor.identity
    advisor.market
    advisor.rolemap
    advisor.assessment
    advisor.target
    advisor.gapplan
    advisor.resume
forbidden_modules =
    advisor.profile.service
    advisor.profile.domain
    advisor.profile.infra
allow_indirect_imports = True

