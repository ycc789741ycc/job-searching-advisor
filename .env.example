# ---------------------------------------------------------------------------
# Every runtime setting the services read lives here. Copy to `.env` and fill
# in. Values differ per environment; names never do.
#
# Rule (design-guideline/ai-context/shared-context.md): a default is allowed
# only for an optional, non-sensitive setting. Hostnames, URLs, connection
# strings and secrets are REQUIRED and fail startup when missing — they are
# left blank below.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=
SERVICE_NAME=job-searching-advisor
LOG_LEVEL=INFO
PORT=8000

# --- Postgres: infra container ----------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=

# --- Postgres: least-privilege role passwords (bootstrapped by start-infra) --
APP_RW_PASSWORD=
CRAWLER_RW_PASSWORD=
AGGREGATOR_PASSWORD=
MIGRATOR_PASSWORD=

# --- Postgres: connection strings, one per role -----------------------------
# api + worker (all module schemas; market is read-only except the documented
# exceptions in docs/technical_boundaries.md section 3)
DATABASE_URL=
# crawler: market shared zone only, no access to any user schema
CRAWLER_DATABASE_URL=
# Alembic
MIGRATOR_DATABASE_URL=
DB_POOL_SIZE=5
DB_STATEMENT_TIMEOUT_MS=30000

# --- Auth: Clerk ------------------------------------------------------------
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_JWKS_URL=
CLERK_JWKS_CACHE_SECONDS=600

# --- Encryption -------------------------------------------------------------
# Base64-encoded 32-byte master key. Wraps the per-record data keys.
# Set on `api` and `worker` ONLY — never on `crawler`.
MASTER_ENCRYPTION_KEY=

# --- Object storage (MinIO locally, S3-compatible elsewhere) ----------------
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PORT=9000
S3_CONSOLE_PORT=9001
SIGNED_URL_TTL_SECONDS=300

# --- Connector OAuth (separate from login OAuth) ----------------------------
OAUTH_REDIRECT_BASE_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_API_BASE_URL=
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_API_BASE_URL=
JIRA_OAUTH_BASE_URL=

# --- AI gateway -------------------------------------------------------------
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_RETRIES=2
AI_DEFAULT_MONTHLY_BUDGET_USD=20

# --- Uploads / parsing limits ------------------------------------------------
RESUME_MAX_BYTES=10485760
RESUME_MAX_PAGES=30
PARSE_TIMEOUT_SECONDS=60

# --- Crawler ----------------------------------------------------------------
CRAWL_USER_AGENT="JobSearchingAdvisorBot/1.0 (+contact in robots policy)"
CRAWL_HTTP_TIMEOUT_SECONDS=30
CRAWL_RATE_LIMIT_PER_HOST_PER_SECOND=1
CRAWL_MANUAL_REFRESH_PER_DAY=3
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Assessment -------------------------------------------------------------
ASSESSMENT_CONFIDENCE_THRESHOLD=0.6

# --- Web client (VITE_ values are PUBLIC — never put a secret here) ---------
VITE_API_BASE_URL=
VITE_CLERK_PUBLISHABLE_KEY=
